APP_NAME=Scientific Research Graph
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://research:research@127.0.0.1:55432/research_graph
POSTGRES_PORT=55432
REDIS_URL=redis://localhost:6379/0
WORKER_QUEUE_NAME=research_jobs

# Optional but recommended for higher Semantic Scholar rate limits.
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_TIMEOUT_SECONDS=20
SEMANTIC_SCHOLAR_MAX_RETRIES=4

EMBEDDING_MODEL_NAME=sentence-transformers/allenai-specter
EMBEDDING_MODEL_VERSION=1
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16
RELATED_WORK_MAX_BYTES=10000000

# Select exactly one document backend: local for development or s3 for production/RustFS.
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_LOCAL_ROOT=./data/document-storage
DOCUMENT_STORAGE_MAX_BYTES=50000000
DOCUMENT_STORAGE_S3_BUCKET=research-documents
DOCUMENT_STORAGE_S3_ENDPOINT_URL=
DOCUMENT_STORAGE_S3_REGION=us-east-1
DOCUMENT_STORAGE_S3_ACCESS_KEY_ID=
DOCUMENT_STORAGE_S3_SECRET_ACCESS_KEY=

# arXiv is the only automatic PDF source; identify deployments with a real contact address.
ARXIV_PDF_BASE_URL=https://export.arxiv.org/pdf
ARXIV_DOWNLOAD_TIMEOUT_SECONDS=30
ARXIV_DOWNLOAD_MAX_RETRIES=3
ARXIV_USER_AGENT=ResearchPapersPet/0.1 (mailto:research@example.com)
